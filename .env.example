# ---------------------------------------------------------------------------
# Xplore Australia CRM — frontend environment template
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# For a production build, copy `.env.production.example` to `.env.production`
# instead — Vite loads that file automatically for `npm run build`.
#
# SECURITY: every VITE_* variable is inlined into the JavaScript bundle that is
# shipped to the browser. Treat all of them as PUBLIC. Never place client
# secrets, API keys or connection strings in this file.
# ---------------------------------------------------------------------------

# Display name used in the header, footer and document title.
VITE_APP_NAME="Xplore Australia CRM"

# ---------------------------------------------------------------------------
# API ADDRESS
#
# An endpoint URL is assembled from three separately-owned parts:
#
#     VITE_API_BASE_URL   https://crmbackend.example.com   ← this file
#     VITE_API_PREFIX     /api                             ← this file
#     endpoint path       /v1/auth/status                  ← src/api/endpoints.js
#     ------------------------------------------------------------------
#     request             https://crmbackend.example.com/api/v1/auth/status
#
# So VITE_API_BASE_URL holds the ORIGIN ONLY. Do not include `/api`, do not
# include `/v1`, and do not paste a full endpoint URL — those parts are already
# accounted for, and adding them again is what produces `/api/v1/v1/auth/status`.
#
# `src/config/apiBaseUrl.js` strips the extra parts and prints a console warning
# rather than issuing a broken request, so a mistake here is loud instead of
# silent. It is still a mistake: fix the value.
#
# Leave EMPTY for a same-origin setup — the Vite dev-server proxy below in
# development, or a reverse proxy that forwards /api to the backend in
# production. This is the default, and it is why local development works with
# no configuration.
VITE_API_BASE_URL=

# The backend's API_PREFIX, verbatim. Change this only if you have changed
# API_PREFIX in backend/.env.
VITE_API_PREFIX="/api"

# Milliseconds before an API request is aborted.
VITE_API_TIMEOUT="15000"

# ---------------------------------------------------------------------------
# DEV SERVER
# ---------------------------------------------------------------------------

# Port the Vite dev server binds to. Must appear in the backend's CORS_ORIGINS.
VITE_DEV_PORT="5173"

# Port used by `npm run preview` for the production build.
VITE_PREVIEW_PORT="4173"

# Backend origin the dev-server proxy forwards /api requests to. Used only when
# VITE_API_BASE_URL is empty, which is the recommended local setup: the browser
# then calls a same-origin /api and CORS never enters the picture.
VITE_DEV_PROXY_TARGET="http://localhost:5000"
