# ---------------------------------------------------------------------------
# Outlook Automation CRM — frontend environment template
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# SECURITY: every VITE_* variable is inlined into the JavaScript bundle that is
# shipped to the browser. Treat all of them as PUBLIC. Never place client
# secrets, API keys or connection strings in this file.
# ---------------------------------------------------------------------------

# Display name used in the header, footer and document title.
VITE_APP_NAME="Outlook Automation CRM"

# Base URL prefixed onto every API request.
# Leave as the relative "/api" so the Vite dev-server proxy forwards it to the
# backend in development and a reverse proxy handles it in production.
VITE_API_BASE_URL="/api"

# Milliseconds before an API request is aborted.
VITE_API_TIMEOUT="15000"

# Port the Vite dev server binds to. Must match VITE_DEV_PORT expectations in
# the backend CORS allow-list.
VITE_DEV_PORT="5173"

# Port used by `npm run preview` for the production build.
VITE_PREVIEW_PORT="4173"

# Backend origin the dev-server proxy forwards /api requests to.
VITE_DEV_PROXY_TARGET="http://localhost:5000"
