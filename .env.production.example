# ---------------------------------------------------------------------------
# Outlook Automation CRM — PRODUCTION frontend environment
#
#     cp .env.production.example .env.production
#
# Vite loads `.env.production` automatically for `npm run build`. It does NOT
# load it for `npm run dev`, so this file cannot affect local development.
#
# READ THIS FIRST: these values are compiled INTO the JavaScript bundle at build
# time. Editing them on the server after uploading `dist/` changes nothing —
# there is no runtime configuration to change. Every edit here requires:
#
#     npm run build          then upload dist/ again
#
# SECURITY: every VITE_* variable ships to the browser. Treat them as PUBLIC.
# ---------------------------------------------------------------------------

VITE_APP_NAME="Outlook Automation CRM"

# The API's ORIGIN — scheme and host, nothing else.
#
#   correct    https://crmbackend.xploreaustralia.com
#   wrong      https://crmbackend.xploreaustralia.com/api
#   wrong      https://crmbackend.xploreaustralia.com/api/v1
#   wrong      https://crmbackend.xploreaustralia.com/api/v1/auth/status
#
# The three wrong forms are all the same mistake — including path the base does
# not own. `/api` comes from VITE_API_PREFIX below and `/v1/...` from
# src/api/endpoints.js. The resolver repairs all four spellings to the same
# base and warns in the console, but configure it correctly.
VITE_API_BASE_URL="https://crmbackend.xploreaustralia.com"

# Must equal API_PREFIX in the backend's .env.
VITE_API_PREFIX="/api"

# Production networks are slower and the workbook endpoints do real work.
VITE_API_TIMEOUT="30000"

# ---------------------------------------------------------------------------
# CHECKLIST — the backend must agree, or the browser blocks the request
#
# In backend/.env on the API server:
#
#   NODE_ENV=production
#   API_PREFIX=/api                                  ← matches VITE_API_PREFIX
#   CORS_ORIGINS=https://crm.xploreaustralia.com     ← the FRONTEND origin,
#                                                      no trailing slash
#   FRONTEND_URL=https://crm.xploreaustralia.com     ← where OAuth returns to
#   MICROSOFT_REDIRECT_URI=https://crmbackend.xploreaustralia.com/api/v1/auth/callback
#   GOOGLE_CALLBACK_URL=https://crmbackend.xploreaustralia.com/api/v1/auth/google/callback
#
# Both redirect URIs must also be registered verbatim in Azure and in the Google
# Cloud console. Those two providers compare strings exactly.
#
# Verify after deploying, in the browser console on https://crm.xploreaustralia.com:
#
#   fetch('https://crmbackend.xploreaustralia.com/api/v1/auth/status',
#         { credentials: 'include' }).then(r => r.json()).then(console.log)
#
# A JSON response means the URL, CORS and cookies are all correct.
# ---------------------------------------------------------------------------
